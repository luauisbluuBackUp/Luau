local function getToEnd()
    local character = getChar()
    local hrp = getRoot()

    if not character or not hrp then
        return
    end

    local destination = Vector3.new(
        -175.885,
        956.650,
        83693.953
    )

    -- Ask Roblox to stream the destination.
    pcall(function()
        localPlayer:RequestStreamAroundAsync(destination)
    end)

    -- Give streaming some time.
    task.wait(2)

    -- Teleport to the destination.
    hrp.CFrame = CFrame.new(destination + Vector3.new(0, 10, 0))

    -- Give the newly loaded area time to appear.
    task.wait(2)

    -- Find the destination objects after teleporting.
    local customsFinal = workspace.Map.Buildings:FindFirstChild("CustomsFinal")

    if not customsFinal then
        warn("CustomsFinal has not streamed in yet.")
        return
    end

    local customsBuilding = customsFinal:FindFirstChild("CustomsBuilding")

    if not customsBuilding then
        warn("CustomsBuilding has not streamed in yet.")
        return
    end

    local finalDoor = customsBuilding:FindFirstChild("FinalDoor")

    if not finalDoor then
        warn("FinalDoor has not streamed in yet.")
        return
    end

    local command = finalDoor:FindFirstChild("Command")

    if not command then
        warn("Command has not streamed in yet.")
        return
    end

    local commandButton = command:FindFirstChild("CommandButton")

    if not commandButton then
        warn("CommandButton has not streamed in yet.")
        return
    end

    local target = commandButton:GetChildren()[4]

    if not target then
        warn("Target #4 doesn't exist.")
        return
    end

    local targetCFrame

    if target:IsA("BasePart") then
        targetCFrame = target.CFrame
    elseif target:IsA("Model") then
        targetCFrame = target:GetPivot()
    else
        warn("Target #4 isn't a BasePart or Model.")
        return
    end

    local tweenInfo = TweenInfo.new(
        2,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    )

    local tween = TweenService:Create(
        hrp,
        tweenInfo,
        {
            CFrame = targetCFrame + Vector3.new(0, 10, 0)
        }
    )

    tween:Play()
end
